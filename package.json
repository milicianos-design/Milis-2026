{
  "name": "plataforma-milicianos",
  "version": "1.0.0",
  "description": "Milis 2026",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/update-icons.mjs",
    "db": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "test": "composer --working-dir=api test",
    "package": "npm run build && mkdir -p build && rm -f build/milis-hostinger.zip && cd dist && zip -qr ../build/milis-hostinger.zip . -x '*.DS_Store'",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.9",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "dompurify": "^3.4.17",
    "editorjs-html": "^3.4.0",
    "lenis": "^1.1.18",
    "marked": "^18.2.0",
    "quill": "^1.3.7"
  }
}
