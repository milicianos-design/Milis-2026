{
    "name": "milicianos/api",
    "description": "Backend de la plataforma Milicianos (foro, notas y cuentas)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9",
        "ezyang/htmlpurifier": "^4.17"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Milis\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Milis\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.2.0" },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
